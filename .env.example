# Copy this to .env and fill in real values.
# NEVER commit .env to git.

# ── PostgreSQL ──────────────────────────────────────
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=

# ── Instagram Graph API ─────────────────────────────
# Long-lived token (60-day expiry — refreshed monthly by cron job)
IG_ACCESS_TOKEN=
# Your own IG Business Account ID (used as the hub for Business Discovery)
IG_BUSINESS_ID=

# ── Zoomph ──────────────────────────────────────────
ZOOMPH_API_KEY=
ZOOMPH_FEED_ID=

# ── AWS ─────────────────────────────────────────────
AWS_S3_BUCKET=
AWS_SNS_TOPIC_ARN=
AWS_REGION=

# ── App ─────────────────────────────────────────────
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
ENVIRONMENT=

# Search Analytics — primary site (truebluetv.com)
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=
GSC_SITE_URL=

# Search Analytics — second site (niltv.com), same service account
GA4_PROPERTY_ID_2=
GSC_SITE_URL_2=

# Meta App Config — brand accounts (one token per account, same Meta app)
# @niltv (legacy var names, do not rename)
BRAND_IG_ACCESS_TOKEN=
BRAND_IG_APP_ID=
BRAND_IG_APP_SECRET=
BRAND_IG_USER_ID=

# @nilstar — own long-lived token + numeric IG user id.
# Leave the token empty to fall back to BRAND_IG_ACCESS_TOKEN (single-token setup).
NILSTAR_IG_ACCESS_TOKEN=
NILSTAR_IG_USER_ID=

# LEGACY fallback — new accounts belong in the brand_accounts DB registry
# instead (one command, no .env edit, no deploy):
#   python -m scripts.add_brand_account --token <EAA...|IG...> --campus <school>
# A DB row overrides the .env entry with the same name. This env path still works: comma-separated
# names (e.g. "amel,foo"); for each NAME add <NAME>_IG_USER_ID= below (and
# <NAME>_IG_ACCESS_TOKEN= only if the account needs its own token — omitted,
# it shares BRAND_IG_ACCESS_TOKEN). Tokens starting with "IG" are auto-routed
# to graph.instagram.com; <NAME>_IG_USER_ID is optional for them.
# Discover ids: python -m scripts.list_ig_accounts
BRAND_IG_EXTRA_ACCOUNTS=
# ── Media valuation ──────────────────────────────────
# Rate card as one JSON object; keep the real values out of the repo.
# {"Instagram":{"cpm":0,"cpe":0,"cpv":0},"Twitter":{...},"Facebook":{...},"Instagram Story":{...},"YouTube":{...},"youtube_live_cpv":0}
# Leave empty to show the source-provided exposure value instead.
VALUATION_RATES=

# ── Athlete onboarding (applications router) ──
# Browser origins allowed to POST the public signup form (comma-separated).
PUBLIC_CORS_ORIGINS=https://niltv.com,https://www.niltv.com,https://dev.dkdfgvugisb3v.amplifyapp.com
SITE_BASE=https://niltv.com
# Where staff-facing links point (new-applicant email, staff sheet).
DASHBOARD_BASE_URL=https://dashboard.niltv.com
FROM_EMAIL=no-reply@niltv.com
# Reply-To on the transactional mail; logo in the email header (empty = site logo)
REPLY_TO_EMAIL=contact@niltv.com
EMAIL_LOGO_URL=
SES_CONFIGURATION_SET=niltv-transactional
APPLICATIONS_NOTIFY_EMAIL=
# Staff Google Sheet mirror of the applications table (export every 15 min).
# Share the sheet (editor) with the service account's client_email; json
# falls back to GA4_CREDENTIALS_JSON when GOOGLE_CREDENTIALS_JSON is empty.
APPLICATIONS_SHEET_ID=
GOOGLE_CREDENTIALS_JSON=
# NIL TV site accounts the signup form signs in with: "<poolId>:<clientId>",
# comma-separated. Empty = no account check.
# dev pool: us-east-1_fxm8vObBQ:2ug2fttouf2gge0lepfvhmjmf3
COGNITO_USER_POOLS=
# DocuSign JWT grant. Leave DOCUSIGN_INTEGRATION_KEY empty to fall back to the
# PowerForm link (emailed on approve).
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# Leave empty: the API asks DocuSign which shard hosts the account.
DOCUSIGN_BASE_URI=
DOCUSIGN_OAUTH_HOST=account.docusign.com
DOCUSIGN_PRIVATE_KEY_PATH=/path/to/docusign.pem
DOCUSIGN_TEMPLATE_ID=
DOCUSIGN_TEMPLATE_ROLE=Athlete
DOCUSIGN_CONNECT_SECRET=
DOCUSIGN_POWERFORM_URL=
# Reply-To on DocuSign notification emails (sender name = the consented user's profile name)
DOCUSIGN_REPLY_EMAIL=contact@niltv.com
DOCUSIGN_REPLY_NAME=NIL TV
# Brand ID from Settings > Brands (empty = account default)
DOCUSIGN_BRAND_ID=
# Stripe Connect (restricted key: Connect -> Accounts: Write) + the
# signing secret of the webhook endpoint posting account.updated.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Must match LINK_SIGNING_SECRET on the payouts start-link function.
LINK_SIGNING_SECRET=

# Roster spreadsheet path used by run_roster_import (kept outside git; default data/roster.xlsx)
ROSTER_XLSX=
