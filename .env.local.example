# Backend settings for running the API on your machine WITHOUT docker compose:
#   cp .env.local.example .env   (the compose stack sets these itself)
#   python -m scripts.migrate && uvicorn backend.main:app --reload
#
# ENVIRONMENT=local disables X-API-Key auth and every side effect (S3, SNS,
# CloudWatch). The app refuses to start in this mode unless DB_HOST is a local
# database, so it can never front the dev or prod database.

ENVIRONMENT=local

DB_HOST=localhost
DB_PORT=55432          # the compose Postgres; 5432 for a native install
DB_NAME=niltv_db
DB_USER=niltv_user
DB_PASS=niltv

DASHBOARD_USERNAME=local
DASHBOARD_PASSWORD=local

# Placeholders — nothing here talks to Instagram/Zoomph unless you run a job by hand.
IG_ACCESS_TOKEN=local
IG_BUSINESS_ID=local
ZOOMPH_API_KEY=local
ZOOMPH_FEED_ID=local
AWS_S3_BUCKET=niltv-dashboard-backups
AWS_REGION=us-east-1
