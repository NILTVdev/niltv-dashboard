# Copy this to .env.local and fill in values for the tier you are working against.
# .env.local is gitignored — NEVER commit real credentials.
# See the root README "Environments" for the local -> dev -> prod flow.

# ── Tier A: LOCAL (default for day-to-day work) ─────────────────────────────
# Backend from `docker compose up` (or `uvicorn` with ENVIRONMENT=local).
# AUTH_DISABLED skips the login page; it is ignored by production builds.
INTERNAL_API_URL=http://localhost:8000
AUTH_DISABLED=true
DASHBOARD_USERNAME=local
DASHBOARD_PASSWORD=local

# ── Tier B: DEV (shared, real auth) ─────────────────────────────────────────
# INTERNAL_API_URL=https://api-dev.niltv.com
# AUTH_DISABLED=false
# DASHBOARD_USERNAME=<dev login>
# DASHBOARD_PASSWORD=<dev login password>
# DASHBOARD_API_KEY=<dev backend DASHBOARD_API_KEY>   # sent as X-API-Key; falls back to the password
